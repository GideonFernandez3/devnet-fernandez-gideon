devices = []


def display_menu():
    # print the menu, return the user's choice
    print("\n=== Network Device Inventory ===")
    print("1. Add a device")
    print("2. View all devices")
    print("3. Count active vs inactive devices")
    print("4. Find a device by name")
    print("5. Exit")

    choose = input("Enter a number: ")
    return choose


def add_device(device_list):
    # ask for name, IP, status — build the string, add to the list
    name = input("Enter device name: ")
    ip = input("Enter IP address: ")
    status = input("Enter status (Active/Inactive): ")

    device = name + " | " + ip + " | " + status
    device_list.append(device)

    print("Device added successfully!")


def view_devices(device_list):
    # loop through and print every device — handle empty list
    if len(device_list) == 0:
        print("No devices found.")
    else:
        print("\n=== All Devices ===")
        for device in device_list:
            print(device)


def count_active_inactive(device_list):
    # loop through, count Active vs Inactive, return both
    active = 0
    inactive = 0

    for device in device_list:
        if "Active" in device:
            active += 1
        elif "Inactive" in device:
            inactive += 1

    return active, inactive


def find_device(device_list):
    # ask for a name, search the list, print result or "not found"
    search_name = input("Enter device name to find: ")

    found = False

    for device in device_list:
        if search_name.lower() in device.lower():
            print("Device found:", device)
            found = True

    if not found:
        print("Device not found.")


# BONUS (optional)
def remove_device(device_list):
    device_name = input("Enter device name to remove: ")

    for device in device_list:
        if device_name.lower() in device.lower():
            device_list.remove(device)
            print("Device removed successfully!")
            return

    print("Device not found.")


def main():
    running = True

    while running:
        choice = display_menu()

        if choice == "1":
            add_device(devices)

        elif choice == "2":
            view_devices(devices)

        elif choice == "3":
            active, inactive = count_active_inactive(devices)
            print("Active devices:", active)
            print("Inactive devices:", inactive)

        elif choice == "4":
            find_device(devices)

        elif choice == "5":
            print("Exiting Network Device Inventory...")
            running = False

        else:
            print("Invalid choice. Please enter 1-5.")


main()
