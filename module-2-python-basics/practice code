def add_student(student_list):
# ask for name, grade, status — build the string, add to the list
name = input("Enter student name: ")
grade = input("Enter grade: ")
status = input("Enter status (Passing/Failing): ")

```
student = name + " | " + grade + " | " + status
student_list.append(student)

print("Student added successfully!")
```

def view_students(student_list):
# loop through and print every student — handle empty list
if len(student_list) == 0:
print("No students found.")
else:
print("\n=== All Students ===")
for student in student_list:
print(student)

def count_passing_failing(student_list):
# loop through, count Passing vs Failing, return both
passing = 0
failing = 0

```
for student in student_list:
    if "Passing" in student:
        passing += 1
    elif "Failing" in student:
        failing += 1

return passing, failing
```

def find_student(student_list):
# ask for a name, search the list, print result or "not found"
search_name = input("Enter student name to find: ")

```
found = False

for student in student_list:
    if search_name.lower() in student.lower():
        print("Student found:", student)
        found = True

if not found:
    print("Student not found.")
```

